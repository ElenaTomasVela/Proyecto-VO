import tifffile
import numpy as np
import matplotlib.pyplot as plt
import tensorflow as tf

from deepcell.model_zoo.panopticnet import PanopticNet
from deepcell_toolbox.deep_watershed import deep_watershed
from deepcell_toolbox.processing import histogram_normalization
from skimage.feature import peak_local_max
from skimage.util import view_as_windows
from skimage.transform import resize


# Guardamos la ruta donde se encuentra el archivo
ruta_archivo = "MAX230426_bCatTracking_Exp91_20230426_73604 AM_f0000_t0000.tif"

imagenes = tifffile.imread(ruta_archivo) # Cargamos el archivo .tif
print("Dimensiones del stack de imágenes:", imagenes.shape) # Comprobamos las dimensiones
print("Tipo de datos del stack de imágenes:", imagenes.dtype) # Comprobamos el tipo de datos para asegurarnos que es uint16

canal_verde = imagenes[:, :, :, 1] # Seleccionamos el canal verde (indice 1)

print("\nDimensiones del canal verde:", canal_verde.shape) # Comprobamos las dimensiones del canal verde


# Imprimimos una imagen para comprobar el correcto funcionamiento
plt.imshow(canal_verde[5], cmap='gray')
plt.axis(False)
plt.show()





# Cargamos el modelo de prediccion
modelo = tf.keras.models.load_model("NuclearSegmentation", compile=False)





# Funcion auxiliar para dividir una imagen en trozos
def patchify(image, patch_size=128):
    # Calculamos el tamanyo de la imagen
    h, w = image.shape
    # Calculamos el tamanyo de cada trozo
    pad_h = (patch_size - h % patch_size) % patch_size
    pad_w = (patch_size - w % patch_size) % patch_size
    # Agregamos padding a la imagen
    image_padded = np.pad(image, ((0, pad_h), (0, pad_w)), mode='reflect')
    # Dividimos la imagen en trozos
    patches = view_as_windows(image_padded, (patch_size, patch_size), step=patch_size)
    # Cambiamos la forma de los trozos
    patches = patches.reshape(-1, patch_size, patch_size)
    return patches, image_padded.shape

# Funcion auxiliar para reconstruir la imagen a partir de los trozos
def reconstruct_from_patches(patches, image_shape, patch_size=128):
    # Calculamos el tamanyo de la imagen
    h, w = image_shape
    # Calculamos la cantidad de trozos en cada dimension
    num_patches_h = h // patch_size
    num_patches_w = w // patch_size
    # Creamos una imagen vacia para reconstruir
    img = np.zeros((h, w), dtype=patches.dtype)

    idx = 0
    # Iteramos cada trozo
    for i in range(num_patches_h):
        for j in range(num_patches_w):
            # Dibujamos el trozo en la imagen en la posicion correspondiente
            img[i*patch_size:(i+1)*patch_size, j*patch_size:(j+1)*patch_size] = patches[idx]
            idx += 1

    return img

# Funciona auxiliar para normalizar la imagen de entrada del modelo
def normalize_percentile(img, lower=1, upper=99.8):
    img = img.astype('float32')                 # Convertimos la imagen a float32
    p1, p2 = np.percentile(img, (lower, upper)) # Calculamos los percentiles
    img = np.clip(img, p1, p2)                  # Recortamos la imagen
    img = img - img.min()                       # Restamos el minimo
    img /= (img.max() + 1e-8)                   # Dividimos por el maximo
    return img                                  # Devolvemos la imagen normalizada





# Seleccionamos el indice de una imagen
idx = 9

# Normalizamos el canal verde
canal_verde_normalizado = np.array([normalize_percentile(img) for img in canal_verde])

# Cargamos la imagen
imagen_original = canal_verde_normalizado[idx]

# Dividimos trozos la imagen para que el modelo pueda procesarla
patches, padded_shape = patchify(imagen_original, patch_size=128)

# Ajustamos la forma de los parches para que el modelo pueda procesarlos (num_patches, 128, 128, 1)
patches_input = patches[..., np.newaxis] 

# Realizamos las predicciones
predicciones = modelo.predict(patches_input)

# Realizamos el postprocesado cada prediccion
mascaras = []
for i in range(len(patches)):                           # Iteramos cada trozo
    pred = [predicciones[0][[i]], predicciones[1][[i]]] # Obtenemos la prediccion de cada trozo
    mask = deep_watershed(         # Aplicamos el algoritmo de watershed a la prediccion
        pred,
        radius=None,    
        maxima_threshold=0.1,      # Que tan alto tiene que ser el valor para que se considere un maximo
        interior_threshold=0.01,   # Que tan seguro debe ser el modelo de que un pixel es el interior de una celula
        exclude_border=False,      # Si se quieren ignorar los bordes de la imagen
        small_objects_threshold=0, # El tamanyo minimo de un objeto para que se considere una celula
        min_distance=10            # La distancia minima entre dos celulas para que se consideren diferentes
    )
    mascaras.append(mask[0])

# Eliminamos la dimension extra sobrante de las mascaras y las convertimos a un array
mascaras = np.array([m.squeeze() for m in mascaras])

# Reconstruimos la imagen completa
mascara_completa = reconstruct_from_patches(mascaras, padded_shape, patch_size=128)

# Visualizamos la mascara completa y la imagen original
plt.figure(figsize=(15, 5))
plt.subplot(1, 2, 1)
plt.title("Imagen original")
plt.axis('off')
plt.imshow(imagen_original, cmap='gray',vmin=0, vmax=1)

plt.subplot(1, 2, 2)
plt.title("Resultado del modelo")
plt.imshow(mascara_completa, cmap='nipy_spectral')
plt.axis('off')
plt.tight_layout()
plt.show()





import os

import numpy as np
import tensorflow as tf
from tensorflow.keras.callbacks import CSVLogger
from tensorflow_addons.optimizers import RectifiedAdam
import yaml

import deepcell
from deepcell.data.tracking import Track, random_rotate, random_translate, temporal_slice
from deepcell.losses import weighted_categorical_crossentropy
from deepcell.model_zoo.tracking import GNNTrackingModel
from deepcell.utils.tfrecord_utils import get_tracking_dataset, write_tracking_dataset_to_tfr
from deepcell.utils.train_utils import count_gpus, rate_scheduler
from deepcell_toolbox.metrics import Metrics
from deepcell_tracking import CellTracker
from deepcell_tracking.metrics import benchmark_tracking_performance, calculate_summary_stats
from deepcell_tracking.trk_io import load_trks
from deepcell_tracking.utils import get_max_cells, is_valid_lineage


# Rutas de ficheros
data_dir = './data'

inf_model_path = "NuclearTrackingInf"
ne_model_path = "NuclearTrackingNE"
metrics_path = "train-metrics.yaml"
train_log_path = "train_log.csv"

prediction_dir = 'output'
# Crear carpeta si no existe
if not os.path.exists(prediction_dir):
    os.makedirs(prediction_dir)


appearance_dim = 32
distance_threshold = 64
crop_mode = "resize"

# Arquitectura del modelo
n_layers = 1  
n_filters = 64
encoder_dim = 64
embedding_dim = 64
graph_layer = "gat"
norm_layer = "batch"

# Creación de datos
seed = 0
track_length = 8 
rotation_range = 180
translation_range = 512
buffer_size = 128

# Parámetros de entrenamiento
batch_size = 8
epochs = 50
steps_per_epoch = 1000
validation_steps = 200
lr = 1e-3


# Funciones para crear más datos

def sample(X, y):
    return temporal_slice(X, y, track_length=track_length)

def rotate(X, y):
    return random_rotate(X, y, rotation_range=rotation_range)

def translate(X, y):
    return random_translate(X, y, range=translation_range)

with tf.device("/cpu:0"):
    train_data = get_tracking_dataset("train")
    train_data = train_data.shuffle(buffer_size, seed=seed).repeat()
    train_data = train_data.map(sample, num_parallel_calls=tf.data.AUTOTUNE)
    train_data = train_data.map(rotate, num_parallel_calls=tf.data.AUTOTUNE)
    train_data = train_data.map(translate, num_parallel_calls=tf.data.AUTOTUNE)
    train_data = train_data.batch(batch_size).prefetch(tf.data.AUTOTUNE)

    val_data = get_tracking_dataset("val")
    val_data = val_data.shuffle(buffer_size, seed=seed).repeat()
    val_data = val_data.map(sample, num_parallel_calls=tf.data.AUTOTUNE)
    val_data = val_data.batch(batch_size).prefetch(tf.data.AUTOTUNE)

max_cells = list(train_data.take(1))[0][0]["appearances"].shape[2]






# Esta celda tarda
train_trks = load_trks(os.path.join(data_dir, "train.trks"))
val_trks = load_trks(os.path.join(data_dir, "val.trks"))

# Cantidad máxima de células en entrenamiento y prueba
max_cells = max([get_max_cells(train_trks["y"]), get_max_cells(val_trks["y"])])

for split, trks in zip({"train", "val"}, [train_trks, val_trks]):
    print(f"Preparing {split} as tf record")

    with tf.device("/cpu:0"):
        tracks = Track(
            tracked_data=trks,
            appearance_dim=appearance_dim,
            distance_threshold=distance_threshold,
            crop_mode=crop_mode,
        )

        write_tracking_dataset_to_tfr(
            tracks, target_max_cells=max_cells, filename=split
        )










