# Lista de callbacks que usaremos durante el entrenamiento del modelo
callbacks = [
    # Guardamos automaticamente el mejor modelo basado en la metrica de validacion que hemos especificado (val_loss)
    tf.keras.callbacks.ModelCheckpoint(
        model_path,               # Ruta donde se guardara el modelo
        monitor=monitor,          # Metrica a monitorizar
        save_best_only=True,      # Indicamos que queremos guardar SOLO el mejor modelo
        verbose=1,                # Verbose para ver el progreso
        save_weights_only=False,  # Guardamos el modelo completo no solo los pesos
    ),

    # Ajustamos la tasa de aprendizaje durante cada epoca del entrenamiento
    tf.keras.callbacks.LearningRateScheduler(rate_scheduler(lr=lr, decay=0.99)),

    # Reduce el learning rate si la metrica de validacion no mejora 
    tf.keras.callbacks.ReduceLROnPlateau(
        monitor=monitor,         # Metrica a monitorizar
        factor=0.1,              # Multiplica la tasa de aprendizaje actual por este factor
        patience=5,              # Numero de epocas sin mejora antes de reducir la tasa
        verbose=1,               # Verbose para ver el progreso
        mode="auto",             # Modo de monitorizacion (auto, min, max)
        min_delta=0.0001,        # Minima mejora en la metrica para considerarla una mejora
        cooldown=0,              # Epocas de espera tras una reduccion antes de volver a reducir la tasa
        min_lr=0,                # Tasa de aprendizaje minima
    ),

    # Detiene el entrenamiento si la metrica de validacion no mejora
    tf.keras.callbacks.EarlyStopping(
        patience=10,               # Numero de epocas sin mejora antes de parar el entrenamiento
        restore_best_weights=True  # Restauramos los mejores pesos del modelo
    ),

    # Guardamos el historial del entrenamiento en formato CSV
    csv_logger,
]

print(f"Training on {count_gpus()} GPUs.")

# Entrenamos el modelo con los datos de entrenamiento y validacion usando los callbacks que hemos definido
history = model.fit(
    train_data,                                          # Datos de entrenamiento
    steps_per_epoch=train_data.y.shape[0] // batch_size, # Pasos por epoca
    epochs=epochs,                                       # Numero de epocas maximo 
    validation_data=val_data,                            # Datos de validacion
    validation_steps=val_data.y.shape[0] // batch_size,  # Pasos por epoca de validacion
    callbacks=callbacks,                                 # Callbacks para el entrenamiento
)

# Mostramos el valor final de val_loss despues de entrenar el modelo
